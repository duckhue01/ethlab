      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "Casper FFG (Economic Finality Gadget)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Casper FFG (Economic Finality Gadget)",
      "autoResize": false,
