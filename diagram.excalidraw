    {
      "id": "cons_sbody_0230",
      "type": "text",
      "x": 382,
      "y": 2296,
      "width": 486,
      "height": 194,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0199"
      ],
      "frameId": null,
      "index": "d0231",
      "roundness": null,
      "seed": 1323750137,
      "version": 1,
      "versionNonce": 1042421192,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 leanVM PQ Proofs (I*): STARK zkVM aggregating ~1600 XMSS/s\n\u2022 leanXMSS PQ Attestations (J*): Poseidon + KoalaBear Winternitz\n  hash-based signatures replacing BLS12-381 (plus EIP-8321 RANDAO)\n\u2022 Tech Debt Reset & leanCL STF in Lean 4 (L*/J*): BLAKE3 state,\n  drop SyncCommittee/min-max balance; real-time cl-asm proofs\n\u2022 Longer term: Secret Proposers (SSLE), 51% recovery, shielded pool",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 leanVM PQ Proofs (I*): STARK zkVM aggregating ~1600 XMSS/s\n\u2022 leanXMSS PQ Attestations (J*): Poseidon + KoalaBear Winternitz\n  hash-based signatures replacing BLS12-381 (plus EIP-8321 RANDAO)\n\u2022 Tech Debt Reset & leanCL STF in Lean 4 (L*/J*): BLAKE3 state,\n  drop SyncCommittee/min-max balance; real-time cl-asm proofs\n\u2022 Longer term: Secret Proposers (SSLE), 51% recovery, shielded pool",
      "autoResize": false,
      "lineHeight": 1.32
    },
