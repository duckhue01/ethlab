      "containerId": null,
      "originalText": "Cryptography & SSZ Serialization",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cons_sbody_0107",
      "type": "text",
      "x": -148,
      "y": 1264,
      "width": 484,
      "height": 144,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0088"
      ],
      "frameId": null,
      "index": "d0108",
      "roundness": null,
      "seed": 1625702881,
      "version": 1,
      "versionNonce": 935745866,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 BLS12-381 (via blst): native signature aggregation lets\n  thousands of votes compress to a single 96-byte signature\n\u2022 SSZ (Simple Serialize): deterministic binary encoding +\n  SHA-256 Merkle tree (hash_tree_root) for light proofs\n\u2022 Fork Digest & Domain Separation prevent cross-fork replay",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 BLS12-381 (via blst): native signature aggregation lets\n  thousands of votes compress to a single 96-byte signature\n\u2022 SSZ (Simple Serialize): deterministic binary encoding +\n  SHA-256 Merkle tree (hash_tree_root) for light proofs\n\u2022 Fork Digest & Domain Separation prevent cross-fork replay",
      "autoResize": false,
      "lineHeight": 1.32
    },
