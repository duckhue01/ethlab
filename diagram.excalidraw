      "text": "Latency Track \u2192 North Star: fast L1 (seconds)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Latency Track \u2192 North Star: fast L1 (seconds)",
