    {
      "id": "cons_sbody_0080",
      "type": "text",
      "x": -738,
      "y": 1220,
      "width": 466,
      "height": 169,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0055"
      ],
      "frameId": null,
      "index": "d0081",
      "roundness": null,
      "seed": 751699573,
      "version": 1,
      "versionNonce": 1361243214,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Min Activation: 32 ETH (MIN_ACTIVATION_BALANCE)\n\u2022 Max Effective Balance: 2048 ETH (0x02 compounding creds)\n\u2022 Legacy 0x01 creds capped at 32 ETH effective balance\n\u2022 Churn-limited PendingDeposits, PendingPartialWithdrawals,\n  and PendingConsolidations queues inside BeaconState",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Min Activation: 32 ETH (MIN_ACTIVATION_BALANCE)\n\u2022 Max Effective Balance: 2048 ETH (0x02 compounding creds)\n\u2022 Legacy 0x01 creds capped at 32 ETH effective balance\n\u2022 Churn-limited PendingDeposits, PendingPartialWithdrawals,\n  and PendingConsolidations queues inside BeaconState",
      "autoResize": false,
      "lineHeight": 1.32
    },
