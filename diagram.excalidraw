      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "Data Availability: PeerDAS (EIP-7594, Fulu)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
