    {
      "id": "cons_sbody_0029",
      "type": "text",
      "x": -2348,
      "y": 1008,
      "width": 464,
      "height": 214,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0016"
      ],
      "frameId": null,
      "index": "d0030",
      "roundness": null,
      "seed": 370353765,
      "version": 1,
      "versionNonce": 276075939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Latest Message-Driven Greedy Heaviest Observed SubTree\n\u2022 Weights branches by validators' latest attestations\n\u2022 Proposer Boost (PROPOSER_REORG_CUTOFF_BPS: 1667 / 2s)\n  defends timely blocks against balancing/ex-ante reorgs\n\u2022 Filters branches by unrealized/justified checkpoints\n\u2022 Pull-up tip & late-block reorg rules in Store",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Latest Message-Driven Greedy Heaviest Observed SubTree\n\u2022 Weights branches by validators' latest attestations\n\u2022 Proposer Boost (PROPOSER_REORG_CUTOFF_BPS: 1667 / 2s)\n  defends timely blocks against balancing/ex-ante reorgs\n\u2022 Filters branches by unrealized/justified checkpoints\n\u2022 Pull-up tip & late-block reorg rules in Store",
      "autoResize": false,
      "lineHeight": 1.32
    },
