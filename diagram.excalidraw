    {
      "id": "cons_stitle_0099",
      "type": "text",
      "x": -148,
      "y": 980,
      "width": 1016,
      "height": 24,
      "angle": 0,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0088"
      ],
      "frameId": null,
      "index": "d0100",
      "roundness": null,
      "seed": 1944393722,
      "version": 1,
      "versionNonce": 1184038099,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "State Transition Function: process_slots() \u2192 process_block() \u2192 process_epoch()",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "State Transition Function: process_slots() \u2192 process_block() \u2192 process_epoch()",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cons_sbody_0101",
      "type": "text",
      "x": -148,
      "y": 1008,
      "width": 1016,
      "height": 192,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0088"
      ],
      "frameId": null,
      "index": "d0102",
      "roundness": null,
      "seed": 1217003031,
      "version": 1,
      "versionNonce": 31196608,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 process_slots(state, slot): advances empty slots, hashes state/block roots into SLOTS_PER_HISTORICAL_ROOT (8192) ring buffers.\n\u2022 process_block(state, block): verifies signature & proposer index; updates randao_mixes; processes ProposerSlashing,\n  AttesterSlashing, Attestations, VoluntaryExits, BLSToExecutionChanges, SyncAggregate, ExecutionPayload & ExecutionRequests.\n\u2022 process_epoch(state): evaluates FFG justification & finalization, issues base/timely-flag rewards & inactivity penalties,\n  processes registry churn, pending deposits/consolidations, and updates ProposerLookahead (EIP-7917).",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 process_slots(state, slot): advances empty slots, hashes state/block roots into SLOTS_PER_HISTORICAL_ROOT (8192) ring buffers.\n\u2022 process_block(state, block): verifies signature & proposer index; updates randao_mixes; processes ProposerSlashing,\n  AttesterSlashing, Attestations, VoluntaryExits, BLSToExecutionChanges, SyncAggregate, ExecutionPayload & ExecutionRequests.\n\u2022 process_epoch(state): evaluates FFG justification & finalization, issues base/timely-flag rewards & inactivity penalties,\n  processes registry churn, pending deposits/consolidations, and updates ProposerLookahead (EIP-7917).",
      "autoResize": false,
      "lineHeight": 1.32
    },
    {
