    {
      "id": "cons_sbody_0173",
      "type": "text",
      "x": -1248,
      "y": 2018,
      "width": 464,
      "height": 194,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0160"
      ],
      "frameId": null,
      "index": "d0174",
      "roundness": null,
      "seed": 1718862860,
      "version": 1,
      "versionNonce": 499741776,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Proposer Slashing: signing two distinct BeaconBlocks\n  for the same (slot, proposer_index)\n\u2022 Attester Double Vote: two attestations with same target.epoch\n\u2022 Attester Surround Vote: source1 < source2 < target2 < target1\n\u2022 Conflicting finalizations guarantee \u2265 1/3 stake is slashable\n\u2022 Correlated penalty scales with total slashed stake in \u00b118 days",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Proposer Slashing: signing two distinct BeaconBlocks\n  for the same (slot, proposer_index)\n\u2022 Attester Double Vote: two attestations with same target.epoch\n\u2022 Attester Surround Vote: source1 < source2 < target2 < target1\n\u2022 Conflicting finalizations guarantee \u2265 1/3 stake is slashable\n\u2022 Correlated penalty scales with total slashed stake in \u00b118 days",
      "autoResize": false,
      "lineHeight": 1.32
    },
