    {
      "id": "cons_sbody_0041",
      "type": "text",
      "x": -2348,
      "y": 1286,
      "width": 464,
      "height": 134,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0016"
      ],
      "frameId": null,
      "index": "d0042",
      "roundness": null,
      "seed": 505125154,
      "version": 1,
      "versionNonce": 1963154967,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Evaluates LMD-GHOST + FFG weight inside each slot\n\u2022 Marks block safe in ~1 slot (~13s) if synchronous & <25% adv.\n\u2022 Exposed via eth_getBlockByNumber('safe') JSON-RPC tag\n\u2022 Liveness-only fallback to Casper FFG under network stress\n\u2022 Opt-in in Prysm (--enable-fast-confirmation) & Lighthouse",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Evaluates LMD-GHOST + FFG weight inside each slot\n\u2022 Marks block safe in ~1 slot (~13s) if synchronous & <25% adv.\n\u2022 Exposed via eth_getBlockByNumber('safe') JSON-RPC tag\n\u2022 Liveness-only fallback to Casper FFG under network stress\n\u2022 Opt-in in Prysm (--enable-fast-confirmation) & Lighthouse",
      "autoResize": false,
      "lineHeight": 1.32
    },
