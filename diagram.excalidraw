      "seed": 1333266308,
      "version": 1,
      "versionNonce": 1479535095,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Sybil resistance via bonded ETH stake (no PoW hashing)\n\u2022 Active set weighted by effective_balance (32\u20132048 ETH)\n\u2022 EIP-7917 (Fulu): Deterministic ProposerLookahead in state\n\u2022 RANDAO beacon randomness mixes per-block BLS reveals\n\u2022 Weak subjectivity checkpoints guard long-range sync",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Sybil resistance via bonded ETH stake (no PoW hashing)\n\u2022 Active set weighted by effective_balance (32\u20132048 ETH)\n\u2022 EIP-7917 (Fulu): Deterministic ProposerLookahead in state\n\u2022 RANDAO beacon randomness mixes per-block BLS reveals\n\u2022 Weak subjectivity checkpoints guard long-range sync",
      "autoResize": false,
      "lineHeight": 1.32
    },
