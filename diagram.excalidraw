    {
      "id": "cons_sbody_0113",
      "type": "text",
      "x": 382,
      "y": 1264,
      "width": 486,
      "height": 144,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0088"
      ],
      "frameId": null,
      "index": "d0114",
      "roundness": null,
      "seed": 965371278,
      "version": 1,
      "versionNonce": 1591463005,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 BlobKZGCommitments validated alongside BeaconBlock\n\u2022 Extended blobs split into 128 custody columns\n  (FIELD_ELEMENTS_PER_EXT_BLOB: 8192, NUMBER_OF_COLUMNS: 128)\n\u2022 Nodes sample/custody column subsets via DataColumnSidecar\n\u2022 BlobParameterOnly (BPO / EIP-7892) dynamic blob schedule",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 BlobKZGCommitments validated alongside BeaconBlock\n\u2022 Extended blobs split into 128 custody columns\n  (FIELD_ELEMENTS_PER_EXT_BLOB: 8192, NUMBER_OF_COLUMNS: 128)\n\u2022 Nodes sample/custody column subsets via DataColumnSidecar\n\u2022 BlobParameterOnly (BPO / EIP-7892) dynamic blob schedule",
      "autoResize": false,
      "lineHeight": 1.32
    },
