    {
      "id": "cons_sbody_0185",
      "type": "text",
      "x": -1248,
      "y": 2276,
      "width": 464,
      "height": 186,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0160"
      ],
      "frameId": null,
      "index": "d0186",
      "roundness": null,
      "seed": 597963686,
      "version": 1,
      "versionNonce": 1814248103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Splits a single validator key across N independent nodes\n  using threshold BLS signatures (e.g., M-of-N shares)\n\u2022 Prevents single-machine downtime & accidental slashings\n\u2022 Improves geographic, client & cloud diversity for stakers\n\u2022 Native complementarity with EIP-7716 anti-correlation goals",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Splits a single validator key across N independent nodes\n  using threshold BLS signatures (e.g., M-of-N shares)\n\u2022 Prevents single-machine downtime & accidental slashings\n\u2022 Improves geographic, client & cloud diversity for stakers\n\u2022 Native complementarity with EIP-7716 anti-correlation goals",
      "autoResize": false,
      "lineHeight": 1.32
    },
