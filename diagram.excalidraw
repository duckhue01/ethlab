      "groupIds": [
        "cons_grp_0199"
      ],
      "frameId": null,
      "index": "d0237",
      "roundness": null,
      "seed": 1632632184,
      "version": 1,
      "versionNonce": 425869817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "Mainnet (Fulu)  \u2500\u2500\u25b6  Glamsterdam (Gloas ePBS + opt-in FCR)  \u2500\u2500\u25b6  Hegot\u00e1 (Heze FOCIL + Lean 4 crypto + PQ registry)\n   \u2500\u2500\u25b6  I*\u2013J* (Decoupled Consensus, Quick Slots EIP-8198, leanVM, leanXMSS, leanCL STF)\n   \u2500\u2500\u25b6  L* & Longer Term (Tech Debt Reset, 1-Round Finality, real-time cl-asm proofs, SSLE, Shielded Pool)\nDetailed fork-by-fork timeline on the right in 'L1 Strawmap \u2014 Ethereum Draft Roadmap' (x = 3700) & consensus-roadmap.md.",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mainnet (Fulu)  \u2500\u2500\u25b6  Glamsterdam (Gloas ePBS + opt-in FCR)  \u2500\u2500\u25b6  Hegot\u00e1 (Heze FOCIL + Lean 4 crypto + PQ registry)\n   \u2500\u2500\u25b6  I*\u2013J* (Decoupled Consensus, Quick Slots EIP-8198, leanVM, leanXMSS, leanCL STF)\n   \u2500\u2500\u25b6  L* & Longer Term (Tech Debt Reset, 1-Round Finality, real-time cl-asm proofs, SSLE, Shielded Pool)\nDetailed fork-by-fork timeline on the right in 'L1 Strawmap \u2014 Ethereum Draft Roadmap' (x = 3700) & consensus-roadmap.md.",
      "autoResize": false,
      "lineHeight": 1.32
    },
