      "link": null,
      "locked": false,
      "text": "Validator Roles & Committees",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Validator Roles & Committees",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cons_sbody_0074",
      "type": "text",
      "x": -1248,
      "y": 1220,
      "width": 464,
      "height": 169,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0055"
      ],
      "frameId": null,
      "index": "d0075",
      "roundness": null,
      "seed": 161652238,
      "version": 1,
      "versionNonce": 156442313,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Attesters: 1/32 of active set per slot across \u226464 committees\n  (TARGET_COMMITTEE_SIZE: 128, MAX_VALIDATORS_PER_COMMITTEE: 2048)\n\u2022 Proposer: 1 validator/slot builds BeaconBlock + ExecutionPayload\n\u2022 Aggregators: ~16/committee pack attestations on subnets\n\u2022 Sync Committee: 512 validators sign headers for light clients",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Attesters: 1/32 of active set per slot across \u226464 committees\n  (TARGET_COMMITTEE_SIZE: 128, MAX_VALIDATORS_PER_COMMITTEE: 2048)\n\u2022 Proposer: 1 validator/slot builds BeaconBlock + ExecutionPayload\n\u2022 Aggregators: ~16/committee pack attestations on subnets\n\u2022 Sync Committee: 512 validators sign headers for light clients",
      "autoResize": false,
      "lineHeight": 1.32
    },
