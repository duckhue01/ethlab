      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "Consensus Block vs. Execution Payload Coupling (Pre-ePBS vs. Gloas)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consensus Block vs. Execution Payload Coupling (Pre-ePBS vs. Gloas)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cons_sbody_0119",
      "type": "text",
      "x": -148,
      "y": 1472,
      "width": 1016,
      "height": 132,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0088"
      ],
      "frameId": null,
      "index": "d0120",
      "roundness": null,
      "seed": 555579693,
      "version": 1,
      "versionNonce": 1508730154,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Mainnet (Fulu): ExecutionPayload & ExecutionRequests sit inline inside BeaconBlockBody (atomic validation).\n\u2022 Glamsterdam (Gloas / EIP-7732): Decouples BeaconBlock (contains SignedExecutionPayloadBid) from\n  SignedExecutionPayloadEnvelope, enabling pipelined execution & blob DA verification before PTC attestation.",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Mainnet (Fulu): ExecutionPayload & ExecutionRequests sit inline inside BeaconBlockBody (atomic validation).\n\u2022 Glamsterdam (Gloas / EIP-7732): Decouples BeaconBlock (contains SignedExecutionPayloadBid) from\n  SignedExecutionPayloadEnvelope, enabling pipelined execution & blob DA verification before PTC attestation.",
      "autoResize": false,
      "lineHeight": 1.32
    },
