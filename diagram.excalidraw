      "versionNonce": 713942187,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 In specs/gloas/, Prysm, Lighthouse & beacon-APIs/types/gloas/\n\u2022 Separates BeaconBlock (bid) from ExecutionPayloadEnvelope\n\u2022 Enshrined Builder registry + pending payments/withdrawals\n\u2022 512-member Payload Timeliness Committee (PTC) attests\n  payload_present & blob_data_available at 75% of slot\n\u2022 Pipelined slot schedule: 25% (3s) / 50% (6s) / 75% (9s)",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 In specs/gloas/, Prysm, Lighthouse & beacon-APIs/types/gloas/\n\u2022 Separates BeaconBlock (bid) from ExecutionPayloadEnvelope\n\u2022 Enshrined Builder registry + pending payments/withdrawals\n\u2022 512-member Payload Timeliness Committee (PTC) attests\n  payload_present & blob_data_available at 75% of slot\n\u2022 Pipelined slot schedule: 25% (3s) / 50% (6s) / 75% (9s)",
      "autoResize": false,
      "lineHeight": 1.32
    },
