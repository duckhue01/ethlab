      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Holds BLS12-381 validator keystores / Web3Signer remote keys\n\u2022 Maintains local Slashing Protection DB (EIP-3076 interchange)\n\u2022 Polls Beacon Node for proposer, attester & sync duties\n\u2022 Signs BeaconBlocks, Attestations, AggregateAndProofs,\n  SyncCommitteeMessages, and BuilderRegistrations",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Holds BLS12-381 validator keystores / Web3Signer remote keys\n\u2022 Maintains local Slashing Protection DB (EIP-3076 interchange)\n\u2022 Polls Beacon Node for proposer, attester & sync duties\n\u2022 Signs BeaconBlocks, Attestations, AggregateAndProofs,\n  SyncCommitteeMessages, and BuilderRegistrations",
      "autoResize": false,
      "lineHeight": 1.32
    },
