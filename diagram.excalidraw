      "link": null,
      "locked": false,
      "text": "Hegot\u00e1 (Heze CL) \u2014 FOCIL & PQ Prep (SFI)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hegot\u00e1 (Heze CL) \u2014 FOCIL & PQ Prep (SFI)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cons_sbody_0218",
      "type": "text",
      "x": 382,
      "y": 2018,
      "width": 486,
      "height": 214,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0199"
      ],
      "frameId": null,
      "index": "d0219",
      "roundness": null,
      "seed": 903657388,
      "version": 1,
      "versionNonce": 813134891,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 In specs/heze/, Prysm upgrade/structs & Lighthouse IL store\n\u2022 EIP-7805 (FOCIL): 16-member InclusionListCommittee per slot;\n  fork choice rejects payloads ignoring timely IL txs\n\u2022 EIP-8015 removes legacy eth1_data/deposits; EIP-8365 bans 0x00\n\u2022 Strawmap Hegot\u00e1 additions: crypto specs in Lean 4 (EthLib)\n  & Post-Quantum Public Key Registry before BLS switchover",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 In specs/heze/, Prysm upgrade/structs & Lighthouse IL store\n\u2022 EIP-7805 (FOCIL): 16-member InclusionListCommittee per slot;\n  fork choice rejects payloads ignoring timely IL txs\n\u2022 EIP-8015 removes legacy eth1_data/deposits; EIP-8365 bans 0x00\n\u2022 Strawmap Hegot\u00e1 additions: crypto specs in Lean 4 (EthLib)\n  & Post-Quantum Public Key Registry before BLS switchover",
      "autoResize": false,
      "lineHeight": 1.32
    },
