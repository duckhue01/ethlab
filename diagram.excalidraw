    {
      "id": "cons_sbody_0224",
      "type": "text",
      "x": -148,
      "y": 2296,
      "width": 484,
      "height": 194,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0199"
      ],
      "frameId": null,
      "index": "d0225",
      "roundness": null,
      "seed": 809039061,
      "version": 1,
      "versionNonce": 1803671977,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Decoupled Consensus (I*): small VRF block-production committee\n  + async finality with expiring LMD-GHOST weights\n\u2022 Quick Slots (J*, EIP-8198): local _features/eip8198 spec sets\n  fork-specific slot duration (10s) & r / r\u00b2 scaling\n\u2022 1-Round Finality (L*): ~95% optimistic fast path + fallback\n\u2022 Slot duration decreases + return to 1M attesters (longer term)",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Decoupled Consensus (I*): small VRF block-production committee\n  + async finality with expiring LMD-GHOST weights\n\u2022 Quick Slots (J*, EIP-8198): local _features/eip8198 spec sets\n  fork-specific slot duration (10s) & r / r\u00b2 scaling\n\u2022 1-Round Finality (L*): ~95% optimistic fast path + fallback\n\u2022 Slot duration decreases + return to 1M attesters (longer term)",
      "autoResize": false,
      "lineHeight": 1.32
    },
