    {
      "id": "cons_sbody_0179",
      "type": "text",
      "x": -738,
      "y": 2018,
      "width": 466,
      "height": 194,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0160"
      ],
      "frameId": null,
      "index": "d0180",
      "roundness": null,
      "seed": 695212692,
      "version": 1,
      "versionNonce": 1826028320,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Triggers automatically if finality stalls > 4 epochs\n  (MIN_EPOCHS_TO_INACTIVITY_PENALTY: 4)\n\u2022 Non-attesting validators lose stake quadratically over time\n\u2022 Active online validators earn zero leak penalty\n\u2022 Gradually restores online validators to \u2265 2/3 of active\n  weight so Casper FFG can resume finalizing",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Triggers automatically if finality stalls > 4 epochs\n  (MIN_EPOCHS_TO_INACTIVITY_PENALTY: 4)\n\u2022 Non-attesting validators lose stake quadratically over time\n\u2022 Active online validators earn zero leak penalty\n\u2022 Gradually restores online validators to \u2265 2/3 of active\n  weight so Casper FFG can resume finalizing",
      "autoResize": false,
      "lineHeight": 1.32
    },
