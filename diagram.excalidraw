      "versionNonce": 1324046169,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 /eth/v1/beacon/*: blocks, states, pool, rewards, genesis\n\u2022 /eth/v1/validator/*: duties (attester/proposer/sync/ptc),\n  block production, aggregate subscriptions\n\u2022 /eth/v1/events: SSE head, block, finality, FCR & payload\n\u2022 /eth/v1/beacon/light_client/*: bootstrap & finality updates\n\u2022 Spec types in workspace: beacon-APIs/types/{phase0..gloas}/",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 /eth/v1/beacon/*: blocks, states, pool, rewards, genesis\n\u2022 /eth/v1/validator/*: duties (attester/proposer/sync/ptc),\n  block production, aggregate subscriptions\n\u2022 /eth/v1/events: SSE head, block, finality, FCR & payload\n\u2022 /eth/v1/beacon/light_client/*: bootstrap & finality updates\n\u2022 Spec types in workspace: beacon-APIs/types/{phase0..gloas}/",
      "autoResize": false,
      "lineHeight": 1.32
    },
