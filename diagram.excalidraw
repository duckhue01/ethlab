      "link": null,
      "locked": false,
      "text": "Engine API (JSON-RPC Authenticated Seam: Beacon Node \u2194 Execution Client)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Engine API (JSON-RPC Authenticated Seam: Beacon Node \u2194 Execution Client)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cons_sbody_0146",
      "type": "text",
      "x": -2348,
      "y": 2268,
      "width": 976,
      "height": 152,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0121"
      ],
      "frameId": null,
      "index": "d0147",
      "roundness": null,
      "seed": 680918473,
      "version": 1,
      "versionNonce": 1049971790,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 engine_forkchoiceUpdatedV3: pushes canonical head/safe/finalized hashes & triggers local payload building.\n\u2022 engine_getPayloadV4/V5: retrieves assembled ExecutionPayload + BlobsBundle + ExecutionRequests for block proposal.\n\u2022 engine_newPayloadV4: verifies EL state transition & transactions; returns VALID / INVALID / SYNCING to CL fork choice.\n\u2022 Execution clients (Geth, Nethermind, Besu, Reth, Erigon) delegate all consensus/fork-choice authority to the CL.",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 engine_forkchoiceUpdatedV3: pushes canonical head/safe/finalized hashes & triggers local payload building.\n\u2022 engine_getPayloadV4/V5: retrieves assembled ExecutionPayload + BlobsBundle + ExecutionRequests for block proposal.\n\u2022 engine_newPayloadV4: verifies EL state transition & transactions; returns VALID / INVALID / SYNCING to CL fork choice.\n\u2022 Execution clients (Geth, Nethermind, Besu, Reth, Erigon) delegate all consensus/fork-choice authority to the CL.",
      "autoResize": false,
      "lineHeight": 1.32
    },
