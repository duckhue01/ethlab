      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "How Gasper Combines Availability & Finality (Ebb-and-Flow)",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How Gasper Combines Availability & Finality (Ebb-and-Flow)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cons_sbody_0053",
      "type": "text",
      "x": -2348,
      "y": 1484,
      "width": 976,
      "height": 120,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0016"
      ],
      "frameId": null,
      "index": "d0054",
      "roundness": null,
      "seed": 208188590,
      "version": 1,
      "versionNonce": 270620841,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 LMD-GHOST keeps the chain live and growing every 12s slot even if >1/3 of validators go offline.\n\u2022 Casper FFG periodically locks canonical history every 32 slots once 2/3 supermajority attests.\n\u2022 If Casper FFG loses 2/3 quorum for >4 epochs, the Inactivity Leak drains offline balances until finality resumes.\n\u2022 Client implementations: prysm/beacon-chain/forkchoice/doubly-linked-tree, lighthouse/consensus/fork_choice, zrnt/eth2/forkchoice.",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 LMD-GHOST keeps the chain live and growing every 12s slot even if >1/3 of validators go offline.\n\u2022 Casper FFG periodically locks canonical history every 32 slots once 2/3 supermajority attests.\n\u2022 If Casper FFG loses 2/3 quorum for >4 epochs, the Inactivity Leak drains offline balances until finality resumes.\n\u2022 Client implementations: prysm/beacon-chain/forkchoice/doubly-linked-tree, lighthouse/consensus/fork_choice, zrnt/eth2/forkchoice.",
      "autoResize": false,
      "lineHeight": 1.32
    },
