    },
    {
      "id": "cons_sbody_0035",
      "type": "text",
      "x": -1838,
      "y": 1008,
      "width": 466,
      "height": 214,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0016"
      ],
      "frameId": null,
      "index": "d0036",
      "roundness": null,
      "seed": 1258161869,
      "version": 1,
      "versionNonce": 1916448805,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 2-round voting over epoch boundary checkpoints\n\u2022 Source \u2192 Target vote reaches \u2265 2/3 stake = Justified\n\u2022 Consecutive justified epoch finalizes parent = Finalized\n\u2022 ~12.8 min best case (2 epochs), ~16 min expected finality\n\u2022 Irreversible barring \u2265 1/3 total stake slashed\n\u2022 Tracks justification_bits & justified/finalized roots",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 2-round voting over epoch boundary checkpoints\n\u2022 Source \u2192 Target vote reaches \u2265 2/3 stake = Justified\n\u2022 Consecutive justified epoch finalizes parent = Finalized\n\u2022 ~12.8 min best case (2 epochs), ~16 min expected finality\n\u2022 Irreversible barring \u2265 1/3 total stake slashed\n\u2022 Tracks justification_bits & justified/finalized roots",
      "autoResize": false,
      "lineHeight": 1.32
    },
