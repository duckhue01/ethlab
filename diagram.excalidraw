    {
      "id": "cons_sbody_0140",
      "type": "text",
      "x": -1838,
      "y": 2018,
      "width": 466,
      "height": 186,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "cons_grp_0121"
      ],
      "frameId": null,
      "index": "d0141",
      "roundness": null,
      "seed": 712145545,
      "version": 1,
      "versionNonce": 1667898482,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794900000000,
      "link": null,
      "locked": false,
      "text": "\u2022 Multi-client ecosystem: Prysm (Go), Lighthouse (Rust),\n  Teku (Java), Nimbus (Nim), Lodestar (TS), Grandine, ZRNT\n\u2022 Runs Fork Choice store (ProtoArray / Doubly-Linked-Tree)\n\u2022 Executes STF, manages Attestation/Slashing/Exit pools\n\u2022 Serves Beacon REST API (:5052) & Light Client sync proofs",
      "fontSize": 13.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\u2022 Multi-client ecosystem: Prysm (Go), Lighthouse (Rust),\n  Teku (Java), Nimbus (Nim), Lodestar (TS), Grandine, ZRNT\n\u2022 Runs Fork Choice store (ProtoArray / Doubly-Linked-Tree)\n\u2022 Executes STF, manages Attestation/Slashing/Exit pools\n\u2022 Serves Beacon REST API (:5052) & Light Client sync proofs",
      "autoResize": false,
      "lineHeight": 1.32
    },
