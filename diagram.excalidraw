    {
      "id": "cons_sbody_0236",
      "type": "text",
      "x": -148,
      "y": 2554,
      "width": 1016,
      "height": 140,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
